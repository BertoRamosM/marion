# Security headers, applied to every page.
# X-Frame-Options       stops the site being embedded in someone else's iframe
#                       (clickjacking a form is the usual motive)
# X-Content-Type-Options stops browsers guessing a file's type
# Referrer-Policy       sends the domain but not the full path to other sites
# Permissions-Policy    denies APIs this site never uses
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Cache localized pages for 1 hour (edge + browser)
# This keeps content reasonably fresh
/fr/*
/en/*
/es/*
  Cache-Control: public, max-age=3600, must-revalidate

# Cache Next.js static assets (JS/CSS) for 1 year (never changes)
# Allows CDN and browser to serve instantly
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images in public folder for 1 year
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Blog images never change once published
/blog/*
  Cache-Control: public, max-age=31536000, immutable

# Cache robots.txt and sitemap.xml for 1 hour
/sitemap.xml
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate

# Cache favicon, logos and carousel stills for 1 year.
#
# /logos/* rather than /logo-no-bg.png: the file is at /logos/logo-no-bg.png,
# so the old rule matched nothing and the logo was served with no cache header
# at all. It matters more now that the logo is sent straight through instead of
# via /_next/image, which was supplying its own caching.
#
# /carousel/* covers the pre-cropped wide hero stills, which are referenced
# directly by the <picture> source and never change once deployed.
/favicon.ico
/logos/*
/carousel/*
  Cache-Control: public, max-age=31536000, immutable
